# PeerLab User Configuration

# Your ASN (use a private ASN from the range 64512-65534)
USER_ASN=64512

# IPv6 prefixes to advertise (comma-separated list)
# Examples:
#   Single prefix:  USER_PREFIXES=2001:db8:1234::/48
#   Multiple:       USER_PREFIXES=2001:db8:1234::/48,2001:db8:5678::/48
# Leave empty to not advertise any prefixes (receive-only mode)
USER_PREFIXES=
